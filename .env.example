# Copy to .env and fill in ONE key to switch on the LLM layer (entity-level sentiment + event extraction).
# Without any key the system runs fully offline on the bundled local model.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional overrides
# NIA_LLM_PROVIDER=anthropic          # anthropic | openai | gemini (default: first key found)
# NIA_LLM_MODEL=                      # default: claude-haiku-5-5 / gpt-4o-mini / gemini-2.5-flash
# NIA_LLM_MAX_ITEMS=500               # cap on headlines sent to the LLM per run (cost guard; rest use local model)
# NIA_LLM_BATCH=15                    # headlines per LLM call
# NIA_SENTIMENT_BACKEND=auto          # auto | local | finbert | lexicon
